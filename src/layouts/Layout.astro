---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import AuthHandler from '../components/AuthHandler.jsx';

--- 

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="svg" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Arbiter - Stock Market Chart Interpreter</title>
		<meta name="description" content="Understand what a price chart is saying. Plain english signal analysis for everyday investors." />
	</head>
	<body class="">
		<AuthHandler client:load />
		<slot />
		<Analytics/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
