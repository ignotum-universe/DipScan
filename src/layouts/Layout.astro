---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import AuthHandler from '../components/AuthHandler.jsx';

--- 

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="svg" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="keywords" content="stock market signals, when to buy stocks, stock chart interpreter, market context" />
		<meta name="category" content="Finance, Investing" />
		<link rel="canonical" href="https://arbiter.quest/" />
		<title>Arbiter - Stock Market Chart Interpreter</title>
		<meta name="description" content="Not sure if now is a good time to buy? Arbiter reads the price action and volume for you and explains charts in plain english. No chart reading needed." />
	</head>
	<body class="">
		<AuthHandler client:load />
		<slot />
		<Analytics/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
