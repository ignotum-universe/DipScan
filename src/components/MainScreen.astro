---
// src/pages/MainScreen.astro
import { getBatchEnrichedStockData, getCalculatedTickerData } from '../utils/stockIndicatorCalculations';
import TickerCard from '../components/TickerCard';
import StockSearch from '../components/StockSearch';
import MarketIsOpen from './MarketIsOpen.astro';
import { isValidTicker } from '../utils/tickerValidator';

// 1. Get token configuration
const userToken = Astro.cookies.get('tiingo_token')?.value;
let activeToken = userToken || import.meta.env.TIINGO_TOKEN;

const DEFAULT_STOCKS = ["GDX", "TSLA", "VOO", "WMT"];
const cookieWatchlist = Astro.cookies.get('watchlist')?.json();
let rawWatchlist: string[] = Array.isArray(cookieWatchlist) ? cookieWatchlist : DEFAULT_STOCKS;

// 2. SANITIZATION GUARD: Scrub incoming tickers against your SEC + ETF JSON records
const cleanWatchlist = rawWatchlist
  .map(t => typeof t === 'string' ? t.trim().toUpperCase() : '')
  .filter(t => isValidTicker(t));

// 3. COOKIE SELF-HEALING: If lengths don't match, we caught gibberish. Sync browser storage.
if (cleanWatchlist.length !== rawWatchlist.length) {
  console.warn("🧹 Page load detected corrupted cookie symbols. Rewriting clean cookie storage.");
  
  Astro.cookies.set('watchlist', JSON.stringify(cleanWatchlist), {
    path: '/',
    maxAge: 60 * 60 * 24 * 7, // 7 days (Matches your API configuration)
    httpOnly: true,
    secure: process.env.NODE_ENV === 'production',
    sameSite: 'lax'
  });
}

// 4. Assign the sanitized list to our working watchlist array
let watchlist = cleanWatchlist;

// 5. Fallback rule if no custom token exists (Restrict guest views to default list assets)
if (!userToken) {
  watchlist = watchlist.filter(ticker => DEFAULT_STOCKS.includes(ticker));
  if (watchlist.length === 0) watchlist = DEFAULT_STOCKS;
}

// Structure declaration for mapped data
interface TickerDataItem {
  symbol: string;
  data: any; 
}

// 6. Secure batch pipelines execution
interface StructuralTickerItem {
  symbol: string;
  isCustom: boolean;
}

const tickerDataMap: StructuralTickerItem[] = watchlist.map((symbol) => ({
  symbol,
  isCustom: !!userToken // Tells the UI whether it's allowed to show the delete button
}));
---
<div id="auth-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
  <div id="modal-content-box" class="bg-white p-6 rounded-xl max-w-md w-full shadow-xl space-y-4 relative">
    <button id="close-modal-btn" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 cursor-pointer">&#x2715;</button>
    
    <h2 id="modal-title" class="text-xl font-bold text-slate-800">Unlock Custom Watchlists</h2>
    
    <p id="modal-desc" class="text-sm text-slate-500">
      To scan custom tickers outside our default featured stocks, connect your own free Tiingo API Token. <br>
      <a href="https://www.tiingo.com/"  target="_blank">https://www.tiingo.com/</a>
    </p>
    
    <div id="modal-form-inputs" class="space-y-4">
      <input type="password" id="token-input" placeholder="Paste your Tiingo Token here..." class="w-full border rounded-lg p-2.5 text-sm" />
      <button id="save-token-btn" class="w-full bg-slate-900 hover:bg-slate-800 text-white rounded-lg p-2.5 font-medium transition-colors cursor-pointer">
        Save Token
      </button>
    </div>

    <div id="modal-confirm-actions" class="hidden grid grid-cols-2 gap-3 pt-2">
      <button id="cancel-disconnect-btn" class="border border-slate-200 text-slate-700  rounded-lg p-2.5 text-sm hover:bg-slate-50 transition-colors cursor-pointer">
        No
      </button>
      <button id="confirm-disconnect-btn" class="bg-rose-600 hover:bg-rose-700 text-white rounded-lg p-2.5 text-sm transition-colors cursor-pointer">
        Yes, Disconnect
      </button>
    </div>
  </div>
</div>

<div class="p-6 max-w mx-auto space-y-6">
  <div class="flex justify-between items-center">
  <a href="/" class="bebas-neue-title text-2xl font-bold text-slate-800">Arbiter</a>
  
  <div class="flex items-center space-x-2">
    <button 
      id="license-badge" 
      class="text-xs px-2.5 py-1 rounded-full font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer"
    >
      Enter Custom Key
    </button>
    <button id="clear-token-btn" class="text-xs px-2.5 py-1 rounded-full font-medium bg-rose-600 text-white hover:bg-rose-700 transition-colors hidden cursor-pointer">Disconnect</button>
  </div>
</div>

  <div class="max-w-md">
    <StockSearch client:load />
  </div>
  <div class="max-w-md">
    <MarketIsOpen/>
  </div>

  <div class="ticker-grid grid grid-cols-1 w-full sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4">
  {tickerDataMap.map(item => (
    <div 
      class="relative group h-full flex flex-col transition-all duration-300" 
      id={`card-${item.symbol}`}
      data-lazy-ticker={item.symbol} 
    >
      {item.isCustom && (
        <button type="button" data-ticker={item.symbol} class="delete-btn absolute top-3 right-3 z-30 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 p-1.5 rounded-md bg-slate-200 hover:bg-rose-500 hover:text-white text-slate-400 transition-all shadow-sm backdrop-blur-sm cursor-pointer hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      )}
      
      {/* 1. Mount Point Initially Houses Your Pre-baked Shimmer Skeleton */}
      <div class="ticker-card-mount h-full">
        <div class="p-5 h-full flex-1 rounded-xl border border-slate-200 bg-white shadow-sm animate-pulse space-y-3">
          <div class="h-5 w-16 bg-slate-200 rounded"></div>
          <div class="h-3 w-32 bg-slate-100 rounded"></div>
          <div class="h-3 w-24 bg-slate-100 rounded"></div>
          <div class="h-3 w-20 bg-slate-100 rounded"></div>
          <div class="border-t border-slate-100 pt-3 mt-3 space-y-2">
            <div class="h-3 w-full bg-slate-100 rounded"></div>
            <div class="h-8 w-full bg-slate-100 rounded-md"></div>
            <div class="h-3 w-34 bg-slate-100 rounded"></div>
          </div>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  @keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%       { transform: translateX(-6px); }
  40%       { transform: translateX(6px); }
  60%       { transform: translateX(-4px); }
  80%       { transform: translateX(4px); }
}

.shake {
  animation: shake 0.4s ease;
}
</style>

<script>
  import { createElement } from 'react';
  import { createRoot } from 'react-dom/client';
  import TickerCard from '../components/TickerCard';

  const localToken = localStorage.getItem('tiingo_token');
  const authModal = document.getElementById('auth-modal');
  const badge = document.getElementById('license-badge') as HTMLButtonElement;

  // Modal element references
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalFormInputs = document.getElementById('modal-form-inputs');
  const modalConfirmActions = document.getElementById('modal-confirm-actions');

  // Update badge UI if they are logged in with their own key
  if (localToken && badge) {
    badge.textContent = 'API Key Active';
    badge.className = 'text-xs px-2.5 py-1 rounded-full font-medium bg-emerald-100 text-emerald-700 pointer-events-none';
  }

  // Proactive Login click handler (on the license badge)
  if (!localToken && badge) {
    badge.addEventListener('click', () => {
      if (!authModal || !modalTitle || !modalDesc || !modalFormInputs || !modalConfirmActions) return;
      modalTitle.textContent = "Unlock Custom Watchlists";
      modalTitle.className = "text-xl font-bold text-slate-800";
      modalDesc.innerHTML = `To scan custom tickers outside our default featured stocks, connect your own free Tiingo API Token from <a href="https://www.tiingo.com/" target="_blank" class="text-emerald-600 hover:underline font-medium">tiingo.com</a>.<br>`;
      modalFormInputs.classList.remove('hidden');
      modalConfirmActions.classList.add('hidden');
      authModal.classList.remove('hidden');
    });
  }

  async function checkAuthStatus() {
  const token = localStorage.getItem('tiingo_token');
  
  if (!token) {
    // If we are on the dashboard and have no token, 
    // maybe we don't even try to fetch?
    console.log("No token detected, showing guest view.");
    return false;
  }
  return true;
}

  async function hydrateSkeletons() {
    // 1. Find all active skeleton cards on the page
    const lazyCards = document.querySelectorAll<HTMLElement>('[data-lazy-ticker]');
    if (lazyCards.length === 0) return;

    const token = localStorage.getItem('tiingo_token');

    // 2. Extract the ticker strings into a clean array: ["GDX", "GOOG", "VOO", "CHA"]
    const tickers = Array.from(lazyCards)
      .map(card => card.getAttribute('data-lazy-ticker'))
      .filter(Boolean);

    try {
      // 3. Fire ONE single batch request to your new Astro API route
      const res = await fetch('/api/batch-cards', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tickers, token })
      });

      if (res.status === 401) {
  // Don't throw, just log and handle the UI
  console.warn("Guest mode active: Custom tickers unauthorized.");
  return; 
}
if (!res.ok) throw new Error('Batch network calculation failed.');
      
      // Destructure the unified results map
      const { results } = await res.json(); 

      // 4. Iterate back through your cards and pop the React components into place natively
      lazyCards.forEach((card) => {
        const ticker = card.getAttribute('data-lazy-ticker');
        if (!ticker || !results[ticker]) return;

        const mountPoint = card.querySelector<HTMLElement>('.ticker-card-mount');
        const deleteBtn = card.querySelector<HTMLButtonElement>('.delete-btn');

        if (mountPoint) {
          const root = createRoot(mountPoint);
          
          // Render your React TickerCard into the pre-existing skeleton box
          root.render(createElement(TickerCard, { ticker, data: results[ticker] }));
          
          // Reveal your delete button now that the card is fully active
          deleteBtn?.classList.remove('hidden');
        }
      });

    } catch (error) {
      console.error('⚠️ Batch hydration process was interrupted:', error);
      
      // Fallback: Clear the spinning animation and display a clean error state if things break
      lazyCards.forEach((card) => {
        const mountPoint = card.querySelector<HTMLElement>('.ticker-card-mount');
        if (mountPoint) {
          mountPoint.innerHTML = `
            <div class="p-5 h-full rounded-xl border border-rose-100 bg-rose-50/50 flex flex-col justify-center items-center text-center">
              <span class="text-xs font-semibold text-rose-600">Sync Error</span>
            </div>
          `;
        }
      });
  }
}

  function showInvalidKey(btn: HTMLButtonElement, originalText: string) {
  btn.textContent = "Enter a Valid Key";
  btn.disabled = false;

  // Trigger shake — remove first in case it's already applied
  btn.classList.remove("shake");
  void btn.offsetWidth; // force reflow so re-adding the class restarts the animation
  btn.classList.add("shake");

  setTimeout(() => {
    btn.textContent = originalText;
    btn.classList.remove("shake");
  }, 2000);
}

// SAVE TOKEN HANDLER (Locks down user input token to client & server context)
document.getElementById('save-token-btn')?.addEventListener('click', async () => {
  const input = document.getElementById('token-input') as HTMLInputElement;
  const cleanToken = input?.value.trim();
  if (!cleanToken) return;

  const saveBtn = document.getElementById('save-token-btn') as HTMLButtonElement;
  const originalText = saveBtn.textContent;

  // Change button state to show it's working
  saveBtn.textContent = "Validating Key...";
  saveBtn.disabled = true;

  // Replace the direct Tiingo fetch with a call to your own backend
try {
  const testRes = await fetch('/api/watchlist', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action: 'SYNC_TOKEN', token: cleanToken })
  });

  if (!testRes.ok) {
    showInvalidKey(saveBtn, originalText);
    return;
  }

  // If the backend successfully validated and saved it, reload
  localStorage.setItem('tiingo_token', cleanToken);
  window.location.reload();

} catch (err) {
  console.error(err);
  showInvalidKey(saveBtn, originalText);
}
});

  // Disconnect warning invocation trigger
  if (localToken) {
    const clearBtn = document.getElementById('clear-token-btn');
    clearBtn?.classList.remove('hidden');
    
    clearBtn?.addEventListener('click', () => {
      if (!authModal || !modalTitle || !modalDesc || !modalFormInputs || !modalConfirmActions) return;
      modalTitle.textContent = "Are you sure you want to disconnect?";
      modalTitle.className = "text-xl font-bold text-rose-600";
      modalDesc.innerHTML = `Disconnecting will remove your API key and wipe your existing watchlist.`;
      modalFormInputs.classList.add('hidden');
      modalConfirmActions.classList.remove('hidden');
      authModal.classList.remove('hidden');
    });
  }

  // Confirm Disconnect Execution
  document.getElementById('confirm-disconnect-btn')?.addEventListener('click', async () => {
    localStorage.removeItem('tiingo_token');
    try {
      await fetch('/api/watchlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'CLEAR_ALL_DATA' })
      });
    } catch (error) {
      console.error('Failed to securely clear session tokens:', error);
    }
    window.location.reload();
  });

  // Cancel/Close Modals handlers
  document.getElementById('cancel-disconnect-btn')?.addEventListener('click', () => authModal?.classList.add('hidden'));
  document.getElementById('close-modal-btn')?.addEventListener('click', () => authModal?.classList.add('hidden'));

  // -------------------------------------------------------
  // UTILITY: Attach a delete listener to any delete button
  // -------------------------------------------------------
  function attachDeleteListener(button: HTMLButtonElement) {
  button.addEventListener('click', async () => {
    const ticker = button.getAttribute('data-ticker');
    const targetCard = document.getElementById(`card-${ticker}`);
    if (!ticker || !targetCard) return;

    // Shrink + fade from center, then collapse the space
    targetCard.style.transformOrigin = 'center center';
    targetCard.style.transition = 'opacity 300ms ease, transform 300ms ease';
    targetCard.style.opacity = '0';
    targetCard.style.transform = 'scale(0)';

    setTimeout(() => {
      // Now collapse the space instantly after the visual is gone
      targetCard.style.transition = 'none';
      targetCard.remove();
    }, 260);

    try {
      await fetch('/api/watchlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'DELETE', ticker })
      });
    } catch (error) {
      console.error('Failed to sync deleted ticker with session:', error);
      targetCard.style.opacity = '1';
      targetCard.style.transform = 'scale(1)';
    }
  });
}

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(attachDeleteListener);

  // -------------------------------------------------------
  // SINGLE UNIFIED ADD HANDLER
  // -------------------------------------------------------
  window.addEventListener('watchlist-updated', async (e: Event) => {
    const ticker = (e as CustomEvent<{ ticker: string }>).detail?.ticker;
    if (!ticker || document.getElementById(`card-${ticker}`)) return;

    if (!localStorage.getItem('tiingo_token')) {
      if (!authModal || !modalTitle || !modalDesc || !modalFormInputs || !modalConfirmActions) return;
      
      // Ensure modal is reset to login look if triggered by search intercept
      modalTitle.textContent = "Unlock Custom Watchlists";
      modalTitle.className = "text-xl font-bold text-slate-800";
      modalDesc.innerHTML = `To scan custom tickers outside our default featured stocks, connect your own free Tiingo API Token from <a href="https://www.tiingo.com/" target="_blank" class="text-emerald-600 hover:underline font-medium">tiingo.com</a>.<br>`;
      modalFormInputs.classList.remove('hidden');
      modalConfirmActions.classList.add('hidden');
      
      authModal.classList.remove('hidden');
      return;
    }

    const wrapper = document.createElement('div');
    wrapper.id = `card-${ticker}`;
    wrapper.className = 'relative group h-full flex flex-col transition-all duration-300 data-[deleted=true]:scale-95 data-[deleted=true]:opacity-0';

    wrapper.innerHTML = `
      <div class="ticker-card-mount h-full">
        <div class="p-5 h-full flex-1 rounded-xl border border-slate-200 bg-white shadow-sm animate-pulse space-y-3">
          <div class="h-5 w-16 bg-slate-200 rounded"></div>
          <div class="h-3 w-32 bg-slate-100 rounded"></div>
          <div class="h-3 w-24 bg-slate-100 rounded"></div>
          <div class="h-3 w-20 bg-slate-100 rounded"></div>
          <div class="border-t border-slate-100 pt-3 mt-3 space-y-2">
            <div class="h-3 w-full bg-slate-100 rounded"></div>
            <div class="h-8 w-full bg-slate-100 rounded-md"></div>
            <div class="h-3 w-3/4 bg-slate-100 rounded"></div>
          </div>
        </div>
      </div>
    `;

    wrapper.style.opacity = '0';
    wrapper.style.transform = 'scale(0.95)';
    const grid = document.querySelector('.ticker-grid');
    if (!grid) return;
    grid.insertBefore(wrapper, grid.firstChild);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        wrapper.style.transition = 'opacity 300ms ease, transform 300ms ease';
        wrapper.style.opacity = '1';
        wrapper.style.transform = 'scale(1)';
        wrapper.addEventListener('transitionend', () => {
          wrapper.style.transition = '';
          wrapper.style.transform = '';
          wrapper.style.opacity = '';
        }, { once: true });
      });
    });

    let data;
    try {
      const res = await fetch(`/api/card/${ticker}`, {
        headers: { 'Authorization': `Bearer ${localStorage.getItem('tiingo_token')}` }
      });
      if (!res.ok) { wrapper.remove(); return; }
      ({ data } = await res.json());

      await fetch('/api/watchlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'ADD', ticker })
      });

    } catch (error) {
      console.error("Failed to process dynamic stock addition context:", error);
      wrapper.remove();
      return;
    }

    const mountPoint = wrapper.querySelector<HTMLElement>('.ticker-card-mount');
    if (!mountPoint) return;

    wrapper.innerHTML = `
      <button
        type="button"
        aria-label="Remove ${ticker}"
        data-ticker="${ticker}"
        class="delete-btn absolute top-3 right-3 z-30 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 p-1.5 rounded-md bg-slate-200 hover:bg-rose-500 hover:text-white text-slate-400 transition-all shadow-sm backdrop-blur-sm cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
      <div class="ticker-card-mount h-full"></div>
    `;

    const newDeleteBtn = wrapper.querySelector<HTMLButtonElement>('.delete-btn');
    if (newDeleteBtn) attachDeleteListener(newDeleteBtn);

    const newMountPoint = wrapper.querySelector<HTMLElement>('.ticker-card-mount');
    if (newMountPoint) {
      const root = createRoot(newMountPoint);
      root.render(createElement(TickerCard, { ticker, data }));
    }
  });

  hydrateSkeletons();
</script>